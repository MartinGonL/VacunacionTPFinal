@model Escuela

@{
    ViewData["Title"] = "Detalle de la Escuela";
}

<div class="container py-4">
    <div class="row">
        <!-- Detalle de la Escuela -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">🏫 Detalle de la Escuela</h4>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="mb-3">
                            <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.8rem;">Nombre de la Escuela</h6>
                            <p class="fs-4 fw-bold text-primary mb-0">@Model.Nombre</p>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-6 mb-3">
                                <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.8rem;">Número de Escuela</h6>
                                <p class="fs-5 mb-0">@(Model.Numero.HasValue ? Model.Numero.Value.ToString() : "N/D")</p>
                            </div>
                            <div class="col-6 mb-3">
                                <h6 class="text-muted mb-1 fw-bold text-uppercase" style="font-size: 0.8rem;">Dirección</h6>
                                <p class="fs-5 mb-0">@(string.IsNullOrEmpty(Model.Direccion) ? "Sin dirección" : Model.Direccion)</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 border-top pt-3 mt-4">
                        @if (User.IsInRole("Administrador") || User.IsInRole("Agente"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.EscuelaID" class="btn btn-primary">Editar Escuela</a>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver a la Lista</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Galería de Fotos y Carga -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0">📸 Galería de Fotos</h4>
                </div>
                <div class="card-body p-4">
                    @if (User.IsInRole("Administrador") || User.IsInRole("Agente"))
                    {
                        <div class="bg-light rounded p-3 mb-4 border">
                            <h5 class="fw-bold mb-3" style="font-size: 1rem;">Agregar Foto de la Escuela</h5>
                            <form asp-action="AgregarFoto" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="EscuelaID" value="@Model.EscuelaID" />
                                
                                <div class="mb-3">
                                    <label class="form-label text-muted" style="font-size: 0.85rem;">Seleccionar Archivo</label>
                                    <input type="file" name="FotoFile" id="fotoEscuelaInput" class="form-control form-control-sm" accept="image/*" required onchange="previewEscuelaFoto(this)" />
                                </div>

                                <div id="escuelaFotoPreviewContainer" class="mb-3 text-center d-none">
                                    <img id="escuelaFotoPreview" src="#" alt="Vista previa" class="img-thumbnail rounded shadow-sm" style="max-height: 150px; object-fit: cover;" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-muted" style="font-size: 0.85rem;">Descripción de la foto</label>
                                    <input type="text" name="Descripcion" class="form-control form-control-sm" placeholder="Ej: Fachada, Patio interno..." />
                                </div>
                                <button type="submit" class="btn btn-dark btn-sm w-100">Subir Foto</button>
                            </form>
                        </div>
                    }

                    <!-- Lista de Fotos -->
                    @if (Model.Fotos != null && Model.Fotos.Any())
                    {
                        <div class="row g-3">
                            @foreach (var foto in Model.Fotos)
                            {
                                <div class="col-sm-6">
                                    <div class="card h-100 border shadow-sm">
                                        <a href="@foto.FotoURL" target="_blank" title="Ver tamaño completo">
                                            <img src="@foto.FotoURL" class="card-img-top" alt="@foto.Descripcion" style="height: 140px; object-fit: cover;" />
                                        </a>
                                        <div class="card-body p-2 d-flex flex-column justify-content-between">
                                            <p class="card-text small text-muted mb-2">@(string.IsNullOrEmpty(foto.Descripcion) ? "Sin descripción" : foto.Descripcion)</p>
                                            @if (User.IsInRole("Administrador") || User.IsInRole("Agente"))
                                            {
                                                <form asp-action="EliminarFoto" asp-route-id="@foto.FotoID" method="post" class="mt-auto">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-1" onclick="return confirm('¿Seguro que deseas eliminar esta foto?');">
                                                        Eliminar
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <p class="mb-0">No hay fotos registradas para esta escuela.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Alumnos Matriculados -->
    <div class="row mt-4 mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">👨‍🎓 Alumnos Matriculados en esta Escuela</h5>
                    <a asp-controller="Alumno" asp-action="Index" class="btn btn-sm btn-light fw-bold text-success">Ver Todos los Alumnos</a>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-5">
                            <input type="text" id="buscarAlumnoEscuelaInput" class="form-control form-control-sm" placeholder="🔍 Buscar por nombre, apellido o DNI..." oninput="buscarAlumnosDinamico(1)" />
                        </div>
                        <div class="col-md-3">
                            <select id="filtroTurno" class="form-select form-select-sm" onchange="buscarAlumnosDinamico(1)">
                                <option value="Todos">☀️/🌙 Todos los Turnos</option>
                                <option value="Mañana">☀️ Turno Mañana</option>
                                <option value="Tarde">🌙 Turno Tarde</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select id="filtroGrado" class="form-select form-select-sm" onchange="buscarAlumnosDinamico(1)">
                                <option value="Todos">📚 Todos los Cursos / Grados</option>
                                <option value="1er Grado">1er Grado (6 años)</option>
                                <option value="2do Grado">2do Grado (7 años)</option>
                                <option value="3er Grado">3er Grado (8 años)</option>
                                <option value="4to Grado">4to Grado (9 años)</option>
                                <option value="5to Grado">5to Grado (10 años)</option>
                                <option value="6to Grado">6to Grado (11 años)</option>
                            </select>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Apellido, Nombre</th>
                                    <th>DNI</th>
                                    <th>Grado / Curso</th>
                                    <th>Turno</th>
                                    <th>Fecha de Nacimiento</th>
                                    <th>Teléfono Tutor</th>
                                    <th class="text-end pe-3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyEscuelaAlumnos">
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Cargando alumnos...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Controles de Paginación Dinámica AJAX -->
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="small text-muted" id="infoAlumnosEscuela">Cargando...</span>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnPaginaAntEscuela" onclick="cambiarPaginaDinamica(-1)">
                                « Anterior
                            </button>
                            <span class="mx-2 small fw-bold" id="indicadorPaginaEscuela">Página 1 de 1</span>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnPaginaSigEscuela" onclick="cambiarPaginaDinamica(1)">
                                Siguiente »
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var escuelaIdActual = @Model.EscuelaID;
        var paginaActualDinamica = 1;
        var totalPaginasDinamicas = 1;

        function previewEscuelaFoto(input) {
            var container = document.getElementById('escuelaFotoPreviewContainer');
            var img = document.getElementById('escuelaFotoPreview');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    img.src = e.target.result;
                    container.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                container.classList.add('d-none');
            }
        }

        function buscarAlumnosDinamico(pagina) {
            if (pagina) paginaActualDinamica = pagina;
            var input = document.getElementById('buscarAlumnoEscuelaInput');
            var turnoSelect = document.getElementById('filtroTurno');
            var gradoSelect = document.getElementById('filtroGrado');

            var q = input ? input.value.trim() : '';
            var turno = turnoSelect ? turnoSelect.value : 'Todos';
            var grado = gradoSelect ? gradoSelect.value : 'Todos';

            var url = `/api/alumnos?escuelaId=${escuelaIdActual}&pagina=${paginaActualDinamica}&q=${encodeURIComponent(q)}&turno=${encodeURIComponent(turno)}&grado=${encodeURIComponent(grado)}`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    var tbody = document.getElementById('tbodyEscuelaAlumnos');
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    
                    totalPaginasDinamicas = data.totalPaginas || 1;
                    paginaActualDinamica = data.paginaActual || 1;

                    var resultados = data.resultados || [];
                    if (resultados.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No se encontraron alumnos registrados para los filtros seleccionados.</td></tr>';
                    } else {
                        resultados.forEach(function(alu) {
                            var fechaStr = alu.fechaNacimiento ? new Date(alu.fechaNacimiento).toLocaleDateString('es-AR') : '-';
                            var turnoBadge = alu.turno === 'Tarde' 
                                ? '<span class="badge bg-warning text-dark">🌙 Tarde</span>' 
                                : '<span class="badge bg-info text-dark">☀️ Mañana</span>';
                            var gradoBadge = `<span class="badge bg-secondary">${alu.grado || '1er Grado'}</span>`;

                            var tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td class="ps-3 fw-bold">${alu.apellido}, ${alu.nombre}</td>
                                <td>${alu.dni}</td>
                                <td>${gradoBadge}</td>
                                <td>${turnoBadge}</td>
                                <td>${fechaStr}</td>
                                <td>${alu.telefonoTutor || 'No asignado'}</td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Alumno/Details/${alu.alumnoID}" class="btn btn-outline-info">
                                            Ver Legajo
                                        </a>
                                        <a href="/RegistroVacunacion/Create?alumnoId=${alu.alumnoID}" class="btn btn-outline-success">
                                            💉 Vacunar
                                        </a>
                                    </div>
                                </td>
                            `;
                            tbody.appendChild(tr);
                        });
                    }

                    document.getElementById('indicadorPaginaEscuela').innerText = `Página ${paginaActualDinamica} de ${totalPaginasDinamicas}`;
                    document.getElementById('infoAlumnosEscuela').innerText = `Mostrando ${resultados.length} de ${data.totalAlumnos || 0} alumnos`;
                    document.getElementById('btnPaginaAntEscuela').disabled = (paginaActualDinamica <= 1);
                    document.getElementById('btnPaginaSigEscuela').disabled = (paginaActualDinamica >= totalPaginasDinamicas);
                })
                .catch(err => {
                    console.error('Error cargando alumnos:', err);
                });
        }

        function cambiarPaginaDinamica(delta) {
            var nueva = paginaActualDinamica + delta;
            if (nueva >= 1 && nueva <= totalPaginasDinamicas) {
                buscarAlumnosDinamico(nueva);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            buscarAlumnosDinamico(1);
        });
    </script>
}
