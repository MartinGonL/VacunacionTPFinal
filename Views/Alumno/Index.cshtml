@{
    ViewData["Title"] = "Gestión de Alumnos";
}

<div id="app" class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold m-0">Gestión de Alumnos</h2>
            <p class="text-muted m-0">Administración de alumnos matriculados y sus escuelas asignadas.</p>
        </div>
        <div>
            <button class="btn btn-primary" @@click="abrirModalCrear">
                Nueva Ficha de Alumno
            </button>
        </div>
    </div>

    <div v-if="errorGeneral" class="alert alert-danger" role="alert">
        {{ errorGeneral }}
    </div>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    🔍
                </span>
                <input type="text" 
                       v-model="filtroNombre" 
                       class="form-control border-start-0" 
                       placeholder="Buscar por nombre o apellido..."
                       @@input="filtrarAlumnos">
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre Completo</th>
                        <th>DNI</th>
                        <th>Grado / Turno</th>
                        <th>Fecha de Nacimiento</th>
                        <th>Teléfono Tutor</th>
                        <th>Escuela</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-if="cargando">
                        <td colspan="7" class="text-center py-5 text-muted">
                            Cargando datos de alumnos...
                        </td>
                    </tr>
                    <tr v-else-if="alumnosFiltrados.length === 0">
                        <td colspan="7" class="text-center py-5 text-muted">
                            No se encontraron alumnos registrados.
                        </td>
                    </tr>
                    <tr v-else v-for="alumno in alumnosFiltrados" :key="alumno.alumnoID">
                        <td class="ps-4">
                            <span class="fw-bold">{{ alumno.apellido }}, {{ alumno.nombre }}</span>
                        </td>
                        <td>{{ alumno.dni }}</td>
                        <td>
                            <span class="badge bg-secondary me-1">{{ alumno.grado || '1er Grado' }}</span>
                            <span :class="alumno.turno === 'Tarde' ? 'badge bg-warning text-dark' : 'badge bg-info text-dark'">
                                {{ alumno.turno === 'Tarde' ? '🌙 Tarde' : '☀️ Mañana' }}
                            </span>
                        </td>
                        <td>{{ formatearFecha(alumno.fechaNacimiento) }}</td>
                        <td>{{ alumno.telefonoTutor || 'No asignado' }}</td>
                        <td>
                            <span class="badge bg-success">
                                {{ alumno.escuela ? alumno.escuela.nombre : 'Sin Escuela' }}
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a :href="'/Alumno/Details/' + alumno.alumnoID" class="btn btn-outline-info">
                                    Ver Legajo
                                </a>
                                <a :href="'/RegistroVacunacion/Create?alumnoId=' + alumno.alumnoID" class="btn btn-outline-success">
                                    Vacunar
                                </a>
                                <button class="btn btn-outline-primary" @@click="abrirModalEditar(alumno)">
                                    Editar
                                </button>
                                <button v-if="esAdmin" class="btn btn-outline-danger" @@click="confirmarEliminar(alumno)">
                                    Eliminar
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div v-if="totalPaginas > 1" class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-0">
            <div class="text-muted small">
                Página {{ paginaActual }} de {{ totalPaginas }}
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item" :class="{ disabled: paginaActual === 1 }">
                        <button class="page-link" @@click="cambiarPagina(paginaActual - 1)">Anterior</button>
                    </li>
                    <li v-for="p in totalPaginas" :key="p" class="page-item" :class="{ active: paginaActual === p }">
                        <button class="page-link" @@click="cambiarPagina(p)">{{ p }}</button>
                    </li>
                    <li class="page-item" :class="{ disabled: paginaActual === totalPaginas }">
                        <button class="page-link" @@click="cambiarPagina(paginaActual + 1)">Siguiente</button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <div class="modal fade" id="alumnoModal" tabindex="-1" aria-labelledby="alumnoModalLabel" aria-hidden="true" ref="modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="alumnoModalLabel">{{ editando ? 'Editar Alumno' : 'Registrar Nuevo Alumno' }}</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" @@click="cerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div v-if="errorFormulario" class="alert alert-danger py-2 small">
                        {{ errorFormulario }}
                    </div>

                    <form @@submit.prevent="guardarAlumno">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Nombre *</label>
                                <input type="text" v-model="form.nombre" class="form-control form-control-sm" :class="{ 'is-invalid': errores.nombre }" placeholder="Nombre del alumno">
                                <div class="invalid-feedback small">{{ errores.nombre }}</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Apellido *</label>
                                <input type="text" v-model="form.apellido" class="form-control form-control-sm" :class="{ 'is-invalid': errores.apellido }" placeholder="Apellido del alumno">
                                <div class="invalid-feedback small">{{ errores.apellido }}</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">DNI *</label>
                                <input type="text" v-model="form.dni" class="form-control form-control-sm" :class="{ 'is-invalid': errores.dni }" placeholder="Solo números">
                                <div class="invalid-feedback small">{{ errores.dni }}</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Fecha de Nacimiento *</label>
                                <input type="date" v-model="form.fechaNacimiento" class="form-control form-control-sm" :class="{ 'is-invalid': errores.fechaNacimiento }">
                                <div class="invalid-feedback small">{{ errores.fechaNacimiento }}</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Turno * (Obligatorio)</label>
                                <select v-model="form.turno" class="form-select form-select-sm" :class="{ 'is-invalid': errores.turno }">
                                    <option value="" disabled>-- Seleccione un turno --</option>
                                    <option value="Mañana">☀️ Turno Mañana</option>
                                    <option value="Tarde">🌙 Turno Tarde</option>
                                </select>
                                <div class="invalid-feedback small">{{ errores.turno }}</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Grado / Curso (Calculado por Edad)</label>
                                <input type="text" class="form-control form-control-sm bg-light fw-bold text-primary" :value="gradoCalculado" readonly>
                                <small class="text-muted" style="font-size: 0.75rem;">Se asigna según año/mes de nacimiento.</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Teléfono del Tutor (Opcional)</label>
                            <input type="text" v-model="form.telefonoTutor" class="form-control form-control-sm" :class="{ 'is-invalid': errores.telefonoTutor }" placeholder="Mínimo 10 dígitos (Ej: 2664123456)">
                            <div class="invalid-feedback small">{{ errores.telefonoTutor }}</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Escuela Asignada *</label>
                            <select v-model="form.escuelaID" class="form-select form-select-sm" :class="{ 'is-invalid': errores.escuelaID }">
                                <option :value="0" disabled>Seleccione una escuela...</option>
                                <option v-for="escuela in escuelas" :key="escuela.escuelaID" :value="escuela.escuelaID">
                                    {{ escuela.nombre }} (N° {{ escuela.numero || 'S/N' }})
                                </option>
                            </select>
                            <div class="invalid-feedback small">{{ errores.escuelaID }}</div>
                        </div>

                        <div class="text-end pt-3 border-top">
                            <button type="button" class="btn btn-sm btn-outline-secondary me-2" data-bs-dismiss="modal" @@click="cerrarModal">Cancelar</button>
                            <button type="button" @@click="guardarAlumno" class="btn btn-sm btn-primary">
                                {{ editando ? 'Guardar Cambios' : 'Registrar Alumno' }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        const { createApp, ref, onMounted, computed } = Vue;

        createApp({
            setup() {
                const alumnos = ref([]);
                const escuelas = ref([]);
                const cargando = ref(false);
                const errorGeneral = ref('');
                const errorFormulario = ref('');
                const filtroNombre = ref('');

                const paginaActual = ref(1);
                const totalPaginas = ref(1);

                const editando = ref(false);
                const form = ref({
                    alumnoID: 0,
                    nombre: '',
                    apellido: '',
                    dni: '',
                    fechaNacimiento: '',
                    telefonoTutor: '',
                    turno: '',
                    grado: '',
                    escuelaID: 0
                });

                const errores = ref({
                    nombre: '',
                    apellido: '',
                    dni: '',
                    fechaNacimiento: '',
                    telefonoTutor: '',
                    escuelaID: ''
                });

                let bootstrapModal = null;

                const esAdmin = ref(@(User.IsInRole("Administrador") ? "true" : "false"));

                let timeoutBusqueda = null;
                const cargarAlumnos = async (pagina = 1) => {
                    cargando.value = true;
                    errorGeneral.value = '';
                    try {
                        let url = `/api/alumnos?pagina=${pagina}`;
                        if (filtroNombre.value && filtroNombre.value.trim()) {
                            url += `&q=${encodeURIComponent(filtroNombre.value.trim())}`;
                        }
                        const response = await fetch(url);
                        if (!response.ok) throw new Error('No se pudieron obtener los datos de los alumnos.');
                        
                        const data = await response.json();
                        alumnos.value = data.resultados || data.Resultados || [];
                        paginaActual.value = data.paginaActual || data.PaginaActual || 1;
                        totalPaginas.value = data.totalPaginas || data.TotalPaginas || 1;
                    } catch (err) {
                        errorGeneral.value = err.message;
                    } finally {
                        cargando.value = false;
                    }
                };

                const filtrarAlumnos = () => {
                    clearTimeout(timeoutBusqueda);
                    timeoutBusqueda = setTimeout(() => {
                        cargarAlumnos(1);
                    }, 300);
                };

                const cargarEscuelas = async () => {
                    try {
                        const response = await fetch('/api/escuelas');
                        if (response.ok) {
                            escuelas.value = await response.json();
                        }
                    } catch (err) {
                        console.error('Error al cargar escuelas:', err);
                    }
                };

                const cambiarPagina = (p) => {
                    if (p >= 1 && p <= totalPaginas.value) {
                        cargarAlumnos(p);
                    }
                };

                const alumnosFiltrados = computed(() => alumnos.value);

                const gradoCalculado = computed(() => {
                    if (!form.value.fechaNacimiento) return 'Seleccione Fecha';
                    const fecha = new Date(form.value.fechaNacimiento + 'T00:00:00');
                    if (isNaN(fecha.getTime())) return 'Seleccione Fecha';

                    if (fecha >= new Date('2019-07-01')) return '1er Grado';
                    if (fecha >= new Date('2018-07-01')) return '2do Grado';
                    if (fecha >= new Date('2017-07-01')) return '3er Grado';
                    if (fecha >= new Date('2016-07-01')) return '4to Grado';
                    if (fecha >= new Date('2015-07-01')) return '5to Grado';
                    return '6to Grado';
                });

                const formatearFecha = (fechaString) => {
                    if (!fechaString) return '';
                    const fecha = new Date(fechaString);
                    const dia = String(fecha.getDate()).padStart(2, '0');
                    const mes = String(fecha.getMonth() + 1).padStart(2, '0');
                    const anio = fecha.getFullYear();
                    return `${dia}/${mes}/${anio}`;
                };

                const formatearFechaParaInput = (fechaString) => {
                    if (!fechaString) return '';
                    return fechaString.split('T')[0];
                };

                const limpiarErrores = () => {
                    errores.value = {
                        nombre: '',
                        apellido: '',
                        dni: '',
                        fechaNacimiento: '',
                        telefonoTutor: '',
                        turno: '',
                        escuelaID: ''
                    };
                    errorFormulario.value = '';
                };

                const inicializarFormulario = () => {
                    form.value = {
                        alumnoID: 0,
                        nombre: '',
                        apellido: '',
                        dni: '',
                        fechaNacimiento: '',
                        telefonoTutor: '',
                        turno: '',
                        grado: '',
                        escuelaID: 0
                    };
                    limpiarErrores();
                };

                const abrirModalCrear = () => {
                    inicializarFormulario();
                    editando.value = false;
                    if (!bootstrapModal) {
                        bootstrapModal = new bootstrap.Modal(document.getElementById('alumnoModal'));
                    }
                    bootstrapModal.show();
                };

                const abrirModalEditar = (alumno) => {
                    limpiarErrores();
                    editando.value = true;
                    form.value = {
                        alumnoID: alumno.alumnoID,
                        nombre: alumno.nombre || '',
                        apellido: alumno.apellido || '',
                        dni: alumno.dni || '',
                        fechaNacimiento: formatearFechaParaInput(alumno.fechaNacimiento),
                        telefonoTutor: alumno.telefonoTutor || '',
                        turno: alumno.turno || 'Mañana',
                        grado: alumno.grado || '1er Grado',
                        escuelaID: alumno.escuelaID || 0
                    };
                    if (!bootstrapModal) {
                        bootstrapModal = new bootstrap.Modal(document.getElementById('alumnoModal'));
                    }
                    bootstrapModal.show();
                };

                const cerrarModal = () => {
                    if (bootstrapModal) {
                        bootstrapModal.hide();
                    }
                };

                const validarFormulario = () => {
                    let valido = true;
                    limpiarErrores();

                    const nombre = (form.value.nombre || '').toString().trim();
                    const apellido = (form.value.apellido || '').toString().trim();
                    const dni = (form.value.dni || '').toString().trim();
                    const fecha = form.value.fechaNacimiento;
                    const telefono = (form.value.telefonoTutor || '').toString().trim();
                    const turno = form.value.turno;
                    const escuelaId = Number(form.value.escuelaID || 0);

                    if (!nombre) {
                        errores.value.nombre = 'El nombre es obligatorio.';
                        valido = false;
                    }
                    if (!apellido) {
                        errores.value.apellido = 'El apellido es obligatorio.';
                        valido = false;
                    }
                    if (!dni) {
                        errores.value.dni = 'El DNI es obligatorio.';
                        valido = false;
                    } else if (!/^\d{7,8}$/.test(dni)) {
                        errores.value.dni = 'El DNI debe contener 7 u 8 dígitos numéricos.';
                        valido = false;
                    }
                    if (!fecha) {
                        errores.value.fechaNacimiento = 'La fecha de nacimiento es obligatoria.';
                        valido = false;
                    }
                    if (!turno || (turno !== 'Mañana' && turno !== 'Tarde')) {
                        errores.value.turno = 'El turno es obligatorio (Mañana o Tarde).';
                        valido = false;
                    }
                    if (telefono.length > 0 && telefono.length < 10) {
                        errores.value.telefonoTutor = 'El teléfono debe tener al menos 10 dígitos.';
                        valido = false;
                    }
                    if (!escuelaId || escuelaId === 0) {
                        errores.value.escuelaID = 'Debe seleccionar una escuela obligatoriamente.';
                        valido = false;
                    }

                    return valido;
                };

                const guardarAlumno = async (e) => {
                    if (e && e.preventDefault) e.preventDefault();

                    if (!validarFormulario()) return;

                    const payload = {
                        alumnoID: form.value.alumnoID,
                        nombre: (form.value.nombre || '').trim(),
                        apellido: (form.value.apellido || '').trim(),
                        dni: (form.value.dni || '').trim(),
                        fechaNacimiento: form.value.fechaNacimiento,
                        telefonoTutor: (form.value.telefonoTutor || '').trim() || null,
                        turno: form.value.turno,
                        grado: gradoCalculado.value,
                        escuelaID: Number(form.value.escuelaID)
                    };

                    const url = editando.value ? `/api/alumnos/${payload.alumnoID}` : '/api/alumnos';
                    const metodo = editando.value ? 'PUT' : 'POST';

                    try {
                        const response = await fetch(url, {
                            method: metodo,
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        });

                        if (!response.ok) {
                            const resText = await response.text();
                            let msg = resText;
                            try {
                                const json = JSON.parse(resText);
                                msg = json.error || json.message || json.title || (typeof json === 'string' ? json : resText);
                            } catch { }

                            if (msg.includes('DNI')) {
                                errores.value.dni = msg.replace(/^"|"$/g, '');
                            } else {
                                errorFormulario.value = msg.replace(/^"|"$/g, '');
                            }
                            return;
                        }

                        cerrarModal();
                        filtroNombre.value = '';
                        await cargarAlumnos(1);
                    } catch (err) {
                        errorFormulario.value = err.message;
                    }
                };

                const confirmarEliminar = async (alumno) => {
                    const confirmacion = confirm(`¿Está seguro que desea eliminar al alumno ${alumno.nombre} ${alumno.apellido}?`);
                    if (confirmacion) {
                        try {
                            const response = await fetch(`/api/alumnos/${alumno.alumnoID}`, {
                                method: 'DELETE'
                            });
                            if (!response.ok) {
                                const errorData = await response.json();
                                throw new Error(errorData.error || 'No se pudo eliminar al alumno.');
                            }
                            cargarAlumnos(paginaActual.value);
                        } catch (err) {
                            errorGeneral.value = err.message;
                        }
                    }
                };

                onMounted(() => {
                    cargarAlumnos();
                    cargarEscuelas();
                });

                return {
                    alumnos,
                    escuelas,
                    cargando,
                    errorGeneral,
                    errorFormulario,
                    filtroNombre,
                    paginaActual,
                    totalPaginas,
                    editando,
                    form,
                    errores,
                    esAdmin,
                    alumnosFiltrados,
                    filtrarAlumnos,
                    cambiarPagina,
                    formatearFecha,
                    abrirModalCrear,
                    abrirModalEditar,
                    cerrarModal,
                    guardarAlumno,
                    confirmarEliminar
                };
            }
        }).mount('#app');
    </script>
}
